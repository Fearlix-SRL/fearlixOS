#!/usr/bin/env bash

echo "Pulling $1 image..."
podman pull ghcr.io/fearlix-srl/$1
echo "Pulled $1 image."
distrobox list | awk '{print $3}' | grep -w $1 >/dev/null 2>/dev/null
if [ $? -eq 0 ]; then
    echo "Removing old $1 container..."
    yes | distrobox rm $1
    echo "Removed old $1 container."
fi
echo "Creating new $1 container..."
distrobox create -i ghcr.io/fearlix-srl/$1
echo "Created new $1 container."
echo "Post install $1..."
distrobox enter -n $1 -- post-install.sh >/dev/null 2>/dev/null && echo "Done." || echo "Nothing to do."
echo "Container $1 successfully installed."
